{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "organization": "GitHub",
          "semanticVersion": "2.18.4",
          "notifications": [],
          "rules": []
        },
        "extensions": [
          {
            "name": "codeql/python-queries",
            "semanticVersion": "1.2.0",
            "rules": [
              {
                "id": "py/sql-injection",
                "name": "py/sql-injection",
                "shortDescription": {
                  "text": "SQL query built from user-controlled sources"
                },
                "fullDescription": {
                  "text": "Building a SQL query from user-controlled sources is vulnerable to insertion of malicious SQL code by the user."
                },
                "defaultConfiguration": {
                  "enabled": true,
                  "level": "error"
                },
                "help": {
                  "text": "# SQL query built from user-controlled sources\nIf a database query (such as a SQL or NoSQL query) is built from user-provided data without sufficient sanitization, a user may be able to run malicious database queries.\n\n## Recommendation\nMost database connector libraries offer a way of safely embedding untrusted data into a query by means of query parameters or prepared statements.\n",
                  "markdown": "# SQL query built from user-controlled sources\nIf a database query is built from user-provided data without sufficient sanitization, a user may be able to run malicious database queries.\n"
                },
                "properties": {
                  "tags": [
                    "security",
                    "external/cwe/cwe-089"
                  ],
                  "description": "Building a SQL query from user-controlled sources is vulnerable to insertion of malicious SQL code by the user.",
                  "id": "py/sql-injection",
                  "kind": "path-problem",
                  "name": "SQL query built from user-controlled sources",
                  "precision": "high",
                  "problem.severity": "error",
                  "security-severity": "8.8"
                }
              },
              {
                "id": "py/weak-sensitive-data-hashing",
                "name": "py/weak-sensitive-data-hashing",
                "shortDescription": {
                  "text": "Use of a broken or weak cryptographic hashing algorithm on sensitive data"
                },
                "fullDescription": {
                  "text": "Using broken or weak cryptographic hashing algorithms can compromise security."
                },
                "defaultConfiguration": {
                  "enabled": true,
                  "level": "warning"
                },
                "properties": {
                  "tags": [
                    "security",
                    "external/cwe/cwe-327",
                    "external/cwe/cwe-328",
                    "external/cwe/cwe-916"
                  ],
                  "kind": "path-problem",
                  "precision": "high",
                  "problem.severity": "warning",
                  "security-severity": "7.5"
                }
              },
              {
                "id": "py/unused-import",
                "name": "py/unused-import",
                "shortDescription": {
                  "text": "Unused import"
                },
                "fullDescription": {
                  "text": "Import is not required as it is not used"
                },
                "defaultConfiguration": {
                  "enabled": true,
                  "level": "note"
                },
                "properties": {
                  "tags": [
                    "maintainability",
                    "useless-code"
                  ],
                  "kind": "problem",
                  "precision": "very-high",
                  "problem.severity": "recommendation"
                }
              }
            ]
          }
        ]
      },
      "invocations": [
