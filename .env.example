# Copy to .env and fill in the providers you intend to use.
# Nephilex runs without any of these using the built-in heuristic provider.

# --- Cloud AI providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Local AI provider (Ollama) ---
# Default endpoint; change if Ollama runs elsewhere.
OLLAMA_HOST=http://localhost:11434

# --- Git hosting tokens (used by `nephilex fix --open-pr` to open pull requests) ---
GITHUB_TOKEN=
GITLAB_TOKEN=
