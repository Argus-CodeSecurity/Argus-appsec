# Benchmarks: cloned corpora are throwaway; results/ IS tracked (published numbers)
benchmarks/.corpora/

# Local working documents that are not part of the published docs
docs/internal/
docs/*.docx

# Environment / secrets
.env
.env.*
!.env.example

# Editors / OS / local tooling state
.claude/
.idea/
.vscode/
.DS_Store
Thumbs.db
